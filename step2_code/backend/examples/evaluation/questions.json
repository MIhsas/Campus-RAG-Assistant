    {
      "question_id": "q03",
      "query": "取消补考资格的情况",
      "answerable": true,
      "evidence": [
        {
          "evidence_id": "e03",
          "document_id": "syn-parse-txt-001",
          "document_sha256": "ea716fadda710f98910bc0e14113baf5655091f10f8eece6db15e61563613d07",
          "parser_version": "1.0",
          "block_id": "b8b8a0c2bf59b405",
          "char_start": 0,
          "char_end": 76,
          "quote": "第四条 下列情况之一者，取消补考资格：\n（一）考试违纪或作弊者；\n（二）缺课累计超过该课程教学时数三分之一者；\n（三）未完成课程实验、实习等实践环节者。"
        }
      ]
    },
    {
      "question_id": "q04",
      "query": "转专业需要什么条件",
      "answerable": true,
      "evidence": [
        {
          "evidence_id": "e04",
          "document_id": "syn-parse-txt-001",
          "document_sha256": "ea716fadda710f98910bc0e14113baf5655091f10f8eece6db15e61563613d07",
          "parser_version": "1.0",
          "block_id": "ce15747a6cdf597a",
          "char_start": 0,
          "char_end": 88,
          "quote": "第五条 学生转专业应当在入学后第一学年末提出申请。转专业条件包括：\n1. 在读期间无违纪记录；\n2. 第一学年加权平均成绩排名在本专业前30%；\n3. 通过接收学院组织的考核。"
        }
      ]
    },
    {
      "question_id": "q05",
      "query": "缓考申请的审批流程和证明材料",
