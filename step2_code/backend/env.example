# DeepSeek 生成适配配置示例 — 占位值，勿放真实密钥。
# 使用方式：在本地终端设置环境变量（PowerShell 示例见 README），或复制本文件为
# 本地未跟踪文件后自行加载。真实密钥只放本地，不进入报告、日志或提交。
#
# 默认不启用生成：只有 CAMPUS_GENERATOR=deepseek 且 DEEPSEEK_API_KEY 非空时
# 才注入 DeepSeekAnswerProvider；启动不发送任何探测请求，搜索/摘录始终可用。

CAMPUS_GENERATOR=deepseek
DEEPSEEK_API_KEY=sk-REPLACE-WITH-LOCAL-KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 规划器（T024，独立显式开关，与 CAMPUS_GENERATOR 相互独立）：
# 只有 CAMPUS_PLANNER=deepseek 且 DEEPSEEK_API_KEY 非空时才注入 DeepSeekPlanner；
# 启动/status/固定流程零规划请求；未联调验证真实服务（planner_live_verified=false）。
# 正常入口亦可用 serve-corpus.py --planner deepseek（CLI 显式开关）。
# CAMPUS_PLANNER=deepseek

# 可选：仅当前进程生效。若本机系统代理导致 api.deepseek.com 的 TLS 连接失败
# （代理路径 TLS 连接失败），可设为直连；不修改系统代理或全局环境。
# NO_PROXY=api.deepseek.com
