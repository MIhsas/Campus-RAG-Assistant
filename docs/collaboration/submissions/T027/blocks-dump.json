    "block_id": "0a7595fda827d87e",
    "locator": {
      "type": "table_row",
      "table_index": 2,
      "row_index": 2
    },
    "text": "缓考申请\t考试前3个工作日\t需医院证明"
  },
  {
    "document_id": "syn-parse-docx-001",
