  },
  {
    "document_id": "syn-pdf-text-001",
    "sha256": "66e0f6287aa365cfcc89f2cad15e4d9213f782c6303c86fb713b086aad71fa76",
    "parser_version": "pdf-1.0",
    "block_id": "3428681d9af60ba3",
    "locator": {
      "type": "pdf_page",
      "page": 1,
      "part": 1
    },
    "text": "【合成测试 PDF — 仅供解析演示，不代表真实学校规定】\n第一章 总则\n第一条 成绩复核申请须在成绩公布后 10 个工作日内提出。\n第二条 复核仅核对分数，不重新评阅试卷。"
  },
  {
    "document_id": "syn-pdf-text-001",
    "sha256": "66e0f6287aa365cfcc89f2cad15e4d9213f782c6303c86fb713b086aad71fa76",
    "parser_version": "pdf-1.0",
    "block_id": "d897e41b44bfa468",
    "locator": {
      "type": "pdf_page",
      "page": 2,
      "part": 1
    },
    "text": "第二章 补充\n第三条 缓考申请不得由他人代办。\n第四条 2024 级学生适用本示例，2025 级另行通知。"
  },
  {
    "document_id": "dis-graduate-defer",
    "sha256": "25f67d9d62217448738f061fb53ea90e2a50989aa5d0c96b6fece003c13cf6bc",
    "parser_version": "1.0",
    "block_id": "4bddfe14cd6fe253",
    "locator": {
      "type": "lines",
      "line_start": 1,
      "line_end": 1
    },
    "text": "【合成测试文件 — 干扰资料，明显标注的合成示例，不代表任何真实学校规定】"
  },
  {
    "document_id": "dis-graduate-defer",
    "sha256": "25f67d9d62217448738f061fb53ea90e2a50989aa5d0c96b6fece003c13cf6bc",
    "parser_version": "1.0",
    "block_id": "ca8441a4b57c3445",
    "locator": {
      "type": "lines",
      "line_start": 3,
      "line_end": 3
    },
    "text": "研究生缓考与创新基金管理办法（合成干扰示例）"
  },
  {
    "document_id": "dis-graduate-defer",
    "sha256": "25f67d9d62217448738f061fb53ea90e2a50989aa5d0c96b6fece003c13cf6bc",
    "parser_version": "1.0",
    "block_id": "bd8bd19f9da798a5",
    "locator": {
      "type": "lines",
      "line_start": 5,
      "line_end": 5
    },
    "text": "第一条 本办法适用于全日制研究生，不适用于本科生。"
  },
  {
    "document_id": "dis-graduate-defer",
    "sha256": "25f67d9d62217448738f061fb53ea90e2a50989aa5d0c96b6fece003c13cf6bc",
    "parser_version": "1.0",
    "block_id": "292ef8b2ddf35040",
    "locator": {
      "type": "lines",
      "line_start": 7,
      "line_end": 7
    },
    "text": "第二条 研究生因科研任务不能参加期末考试的，应在考试前 7 个工作日内向研究生院提交缓考申请，并附导师签字的科研任务说明。"
  },
  {
    "document_id": "dis-graduate-defer",
    "sha256": "25f67d9d62217448738f061fb53ea90e2a50989aa5d0c96b6fece003c13cf6bc",
    "parser_version": "1.0",
    "block_id": "089ff10bd5ffc6c6",
    "locator": {
      "type": "lines",
      "line_start": 9,
      "line_end": 9
    },
    "text": "第三条 研究生创新基金每年 4 月受理申请，申请人须提交研究计划书一式两份。"
  },
  {
    "document_id": "dis-scholarship",
    "sha256": "35073428d5fd09cac4113786a008c95340d232cc5e26d06e4372512e8aed0576",
    "parser_version": "1.0",
    "block_id": "4603fccd6fec417b",
    "locator": {
      "type": "lines",
      "line_start": 1,
      "line_end": 1
    },
    "text": "【合成测试文件 — 干扰资料，明显标注的合成示例，不代表任何真实学校规定】"
  },
  {
    "document_id": "dis-scholarship",
    "sha256": "35073428d5fd09cac4113786a008c95340d232cc5e26d06e4372512e8aed0576",
    "parser_version": "1.0",
    "block_id": "bfb251ec48d2198a",
    "locator": {
      "type": "lines",
      "line_start": 3,
      "line_end": 3
    },
    "text": "学校奖学金评定细则（合成干扰示例）"
  },
  {
    "document_id": "dis-scholarship",
    "sha256": "35073428d5fd09cac4113786a008c95340d232cc5e26d06e4372512e8aed0576",
    "parser_version": "1.0",
    "block_id": "83f7605d589dbe36",
    "locator": {
      "type": "lines",
      "line_start": 5,
      "line_end": 5
    },
    "text": "第一条 学校奖学金用于奖励品学兼优的本科生。"
  },
  {
    "document_id": "dis-scholarship",
    "sha256": "35073428d5fd09cac4113786a008c95340d232cc5e26d06e4372512e8aed0576",
    "parser_version": "1.0",
    "block_id": "3dfa7d4a91e653e9",
    "locator": {
      "type": "lines",
      "line_start": 7,
      "line_end": 7
    },
    "text": "第二条 学校奖学金评定的学分绩点要求为加权平均成绩 85 分以上，且当学年无课程不合格。"
  },
  {
    "document_id": "dis-scholarship",
    "sha256": "35073428d5fd09cac4113786a008c95340d232cc5e26d06e4372512e8aed0576",
    "parser_version": "1.0",
    "block_id": "37e56c8d646deb92",
    "locator": {
      "type": "lines",
      "line_start": 9,
      "line_end": 9
    },
    "text": "第三条 学校奖学金每学年评定一次，于每年 10 月公布名单。"
  }
]
